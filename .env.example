# ─── MVP Deploy — Environment Variables ──────────────────────────
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git.

# ─── MySQL ───────────────────────────────────────────────────────
# Generate strong passwords: openssl rand -base64 32
MYSQL_PASSWORD=changeme_strong
MYSQL_ROOT_PASSWORD=changeme_root_strong

# ─── App Backend ─────────────────────────────────────────────────
APP_ID=                            # Application ID (your app identifier)
APP_SECRET=                        # JWT signing secret — use: openssl rand -base64 48

# ─── Kimi OAuth (placeholder if not using OAuth login) ─────────
# If you're NOT using Kimi OAuth, leave these as placeholders.
# The app requires valid URLs to start, but won't call them unless
# someone actually logs in via OAuth.
KIMI_AUTH_URL=https://placeholder.example.com
KIMI_OPEN_URL=https://placeholder.example.com

# ─── Admin Role ──────────────────────────────────────────────────
# Union ID of the app creator (gets "admin" role on first login).
# If you don't use Kimi OAuth, leave this empty.
OWNER_UNION_ID=

# ─── Cloudflare Tunnel ───────────────────────────────────────────
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels
# 1. Create a tunnel
# 2. Give it a name (e.g. "medvene")
# 3. Copy the token
# 4. Add a public hostname: <subdomain>.<your-domain>.com → http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=